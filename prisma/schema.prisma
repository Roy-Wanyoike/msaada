// Msaada schema — adapted from the Supabase migration to Prisma + SQLite.
// NOTE: SQLite has no native `text[]`/`timestamptz`/`gen_random_uuid()`.
// - observed_indicators is stored as a JSON-encoded TEXT and decoded in app code.
// - timestamps default to now() (Prisma stores ISO strings).
// - ids use cuid().
// De-identification is enforced at the data layer: the raw free-text CHV
// observation is NEVER persisted. Only the Qwen-returned structured fields
// (classification, observed_indicators, aggregate_tag, chp_next_action,
// confidence_note, escalation) plus county/ward and the submitting CHV id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// User — a verified member of a health organization operating within an
/// explicit scope (institution-led, NOT self-signup). Roles:
/// MOH_ADMIN, MOH_OFFICER, COUNTY_ADMIN, SUBCOUNTY_ADMIN, CHO_SUPERVISOR,
/// CHV, PROGRAM_ADMIN, AUDITOR, SYSTEM_ADMIN.
/// Onboarding state machine (§10):
/// INVITED -> VERIFICATION_PENDING -> VERIFIED -> CREDENTIALS_CREATED ->
/// DEVICE_REGISTERED -> ACTIVE. Suspension: ACTIVE -> SUSPENDED -> REACTIVATED.
/// Permanent exit: ACTIVE -> DEACTIVATED. Never delete the identity.
model ChvUser {
  id        String   @id @default(cuid())
  email     String   @unique
  fullName  String?
  county    String?
  ward      String?
  passwordHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---- Institution-led identity (§2, §10) ----
  /// Role: moh_admin | moh_officer | county_admin | subcounty_admin |
  /// cho_supervisor | chv | program_admin | auditor | system_admin
  role        String   @default("chv")
  /// Onboarding state machine: invited | verification_pending | verified |
  /// credentials_created | device_registered | active | suspended | deactivated
  authState   String   @default("active")
  /// Organization this user belongs to (nullable for backward compat).
  organizationId String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  /// Who invited/created this user (nullable for self-registered demo users).
  invitedById String?

  triageRecords TriageRecord[]
  households    Household[]
  encounters    Encounter[]
  referrals     Referral[]
  invitations   Invitation[] @relation("InvitedBy")
  supervisedCHUs CommunityHealthUnit[]
}

/// Organization — multi-tenant hierarchy (§1, §15).
/// Ministry of Health -> County Health Department -> Sub-county ->
/// Community Health Units -> Partner Programs.
model Organization {
  id        String   @id @default(cuid())
  name      String
  /// Type: moh | county_department | subcounty | chu | program_partner
  type      String   @default("county_department")
  county    String?
  /// Self-reference for the hierarchy (county -> sub-county -> CHU).
  parentId  String?
  parent    Organization? @relation("OrgHierarchy", fields: [parentId], references: [id])
  children  Organization[] @relation("OrgHierarchy")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         ChvUser[]
  invitations   Invitation[]
  healthUnits   CommunityHealthUnit[]

  @@index([parentId])
  @@index([type])
}

/// Community Health Unit — the operational unit CHVs are assigned to (§5).
model CommunityHealthUnit {
  id              String   @id @default(cuid())
  name            String
  county          String
  subCounty       String?
  ward            String?
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  /// The supervisor assigned to this CHU.
  supervisorId    String?
  supervisor      ChvUser?  @relation(fields: [supervisorId], references: [id])
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([county])
  @@index([organizationId])
}

/// Invitation — institution-led onboarding (§3, §10).
/// A County Admin invites a CHV; the CHV receives an invite, verifies
/// identity, sets credentials, registers a device, and becomes ACTIVE.
/// Status: pending | accepted | expired | revoked
model Invitation {
  id        String   @id @default(cuid())
  /// The invitee's email or phone (for the demo, email).
  email     String
  fullName  String?
  /// Role the invitee will have once onboarded.
  role      String   @default("chv")
  /// Organization the invitee will belong to.
  organizationId String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  /// Who sent the invitation.
  invitedById String
  invitedBy   ChvUser  @relation("InvitedBy", fields: [invitedById], references: [id])
  /// Invitation token (for the invite link).
  token     String   @unique
  status    String   @default("pending") // pending | accepted | expired | revoked
  expiresAt DateTime
  acceptedAt DateTime?
  /// The CHU the invitee will be assigned to (for CHVs).
  chuId     String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([status])
  @@index([invitedById])
}

model TriageRecord {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())

  // Demographic context (de-identified: no household names / addresses)
  county            String
  ward              String?

  // Triage output (model-derived, never raw observation text)
  classification    String   // routine | needs_followup | needs_facility_referral
  escalation        Boolean  @default(false)
  // Whether the spec fallback was used (Qwen parse failure → needs_followup
  // + confidence_note "model output could not be parsed"). Persisted so the
  // DTO contract is authoritative on retrieval (TriageResultCard's amber
  // "Caution fallback applied" banner shows on revisited records).
  fallbackUsed      Boolean  @default(false)
  observedIndicators String   // JSON-encoded string[] (SQLite has no arrays)
  aggregateTag      String?
  chpNextAction     String?
  chpInstruction     String?  // populated only on escalation=true (crisis)
  crisisLine        String?  // populated only on escalation=true (crisis)
  confidenceNote    String?

  // Submission audit / ownership (mirrors the `submitted_by` RLS column)
  submittedById     String
  submittedBy       ChvUser  @relation(fields: [submittedById], references: [id])

  // Identity chain (§2,§6,§15): links to the Encounter that generated this
  // observation. Nullable for backward compat with pre-encounter records.
  encounterId       String?
  encounter         Encounter? @relation(fields: [encounterId], references: [id])

  // Follow-up tracking (one-to-many — a triage can have at most one open
  // follow-up, but history is retained after resolution).
  followUps         FollowUp[]

  @@index([county, createdAt])
  @@index([classification])
  @@index([aggregateTag])
  @@index([escalation])
  @@index([encounterId])
}

// A separate aggregate view table is not needed with Prisma — the dashboard
// route computes aggregates via grouped queries and NEVER selects
// observed_indicators text. See README for the RLS / view-equivalent design.

/// Audit log — records every triage event for compliance without ever
/// storing the observation text. Each entry captures WHO (chvId, but the
/// dashboard view renders it as a truncated hash, never the email), WHEN,
/// WHERE (county/ward), and the model's classification/escalation verdict.
/// This is the "system of record for safety events" — useful for incident
/// review and for demonstrating that the never-persist invariant held.
model AuditLog {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  triageRecordId String?  // link to the TriageRecord (nullable for non-record events)
  actorId        String   // the CHV who triggered the event
  event          String   // e.g. "triage_classified", "crisis_override", "fallback_used"
  county         String
  ward           String?
  classification String?
  escalation     Boolean  @default(false)
  fallbackUsed   Boolean  @default(false)
  piiRedactions  String?  // JSON counts from the scrubber (phone/email/id/name), never the redactions
  /// Policy engine version + workflow classification (section 12, 21 -- auditable).
  policyVersion  String?
  workflowClass  String?  // routine|follow_up_required|referral_required|human_review|crisis_override
  /// Referral created by this triage (if any).
  referralId     String?

  @@index([createdAt])
  @@index([actorId])
  @@index([county])
  @@index([event])
}

/// Follow-up tracking — when a triage produces needs_followup or
/// needs_facility_referral, a FollowUp row is created so the CHV can track
/// whether the recommended next action was completed. Status transitions:
/// pending -> done | missed. De-identified (no observation text; links to
/// the TriageRecord for the structured verdict only).
model FollowUp {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  /// Due date — defaults to createdAt + 48h (the spec's "revisit within 48h").
  dueAt           DateTime
  /// Status: pending | done | missed.
  status          String   @default("pending")
  /// When the CHV marked it done/missed.
  resolvedAt      DateTime?
  /// Optional note the CHV adds when resolving (e.g. "revisited, mother improving").
  /// De-identified — the CHV is reminded not to include names/addresses.
  resolutionNote  String?

  triageRecordId  String
  triageRecord    TriageRecord @relation(fields: [triageRecordId], references: [id], onDelete: Cascade)

  /// The CHV responsible for the follow-up (ownership-scoped — RLS equivalent).
  chvId           String

  /// Links to the Referral that generated this follow-up (§14). Nullable for
  /// backward compat + for follow-ups not tied to a referral.
  referralId      String?
  referral        Referral?  @relation(fields: [referralId], references: [id])

  @@index([chvId, status])
  @@index([dueAt])
  @@index([status])
  @@index([referralId])
}

// =====================================================================
// IDENTITY CHAIN (§2, §3, §6, §13, §15, §28)
// Household → Member → Encounter → Observation → Policy → Referral → Follow-up
// Stable internal IDs (MSD-HH-XXXX, MSD-M-XXXX, etc.) — names are attributes,
// never primary keys. Data minimization: only collect what's needed.
// =====================================================================

/// Household — a group of people the CHW is authorized to visit. The CHW
/// only sees households assigned to them (RBAC §5, §18).
model Household {
  id            String   @id @default(cuid())
  /// Stable, human-readable code (MSD-HH-XXXX) — the public identifier.
  householdCode String   @unique
  /// The CHV assigned to this household (ownership-scoped).
  chwId         String
  chw           ChvUser  @relation(fields: [chwId], references: [id])
  /// Location context (coarse — no addresses, per §3 data minimization).
  county        String
  ward          String?
  /// A short, de-identified label the CHV uses to recognize the household
  /// (e.g. "Household 18, Kariobangi"). NOT a name — just a mnemonic.
  label         String
  status        String   @default("active") // active | inactive | closed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       HouseholdMember[]
  encounters    Encounter[]

  @@index([chwId])
  @@index([county])
  @@index([status])
}

/// Household Member — an individual within a household. displayName is an
/// attribute (NOT a primary key). The member ID (MSD-M-XXXX) is the stable
/// internal identifier. Data minimization: no phone/address unless authorized.
model HouseholdMember {
  id            String   @id @default(cuid())
  /// Stable code (MSD-M-XXXX).
  memberCode    String   @unique
  householdId   String
  household     Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// Display label (e.g. "Mama", "Baba", "Mtoto — age 8"). NOT a real name
  /// by default — the CHV may use a kinship label to avoid storing names.
  displayName   String
  /// Kinship/role context (mother/father/child/grandparent/other).
  role          String?
  /// Age band (not exact DOB — data minimization per §3).
  ageBand       String?  // <5 | 5-14 | 15-24 | 25-49 | 50+
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  encounters    Encounter[]

  @@index([householdId])
  @@index([status])
}

/// Encounter — a single visit/interaction. Has a lifecycle (§6):
/// draft → in_progress → completed → processing → processed → closed.
/// Links to household + member + CHW (identity chain §15).
model Encounter {
  id              String   @id @default(cuid())
  /// Stable code (MSD-ENC-XXXX).
  encounterCode   String   @unique
  householdId     String
  household       Household @relation(fields: [householdId], references: [id])
  memberId        String
  member          HouseholdMember @relation(fields: [memberId], references: [id])
  chwId           String
  chw             ChvUser  @relation(fields: [chwId], references: [id])
  /// Lifecycle state (§6).
  status          String   @default("draft") // draft|in_progress|completed|sync_pending|synced|processing|processed|requires_review|closed
  /// How the observation was captured (§7).
  captureMethod   String   @default("text") // text | voice | mixed
  /// Connectivity state at creation (§17 offline-first).
  connectivity    String   @default("online") // online | offline | intermittent
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  triageRecords   TriageRecord[]
  referrals       Referral[]

  @@index([chwId])
  @@index([householdId])
  @@index([memberId])
  @@index([status])
}

/// Referral — links to the encounter + member that generated it (§13).
/// Has a full lifecycle: created → sent → acknowledged → in_progress →
/// completed | declined | cancelled | expired. "Referral Created" ≠ "Help
/// Received" (§13) — the workflow is tracked to completion.
model Referral {
  id              String   @id @default(cuid())
  /// Stable code (MSD-REF-XXXX).
  referralCode    String   @unique
  encounterId     String
  encounter       Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  householdId     String
  memberId        String
  /// Category from an authorized config (not invented — §12, §27).
  category        String   // mental_health | maternal | child_health | etc.
  /// Priority (deterministic — set by the policy engine, NOT the AI).
  priority        String   @default("routine") // routine | urgent | emergency
  /// Destination facility/program (from authorized config — §27 no fake integrations).
  destination     String?
  /// Lifecycle state (§13).
  status          String   @default("created") // created|sent|acknowledged|in_progress|completed|declined|cancelled|expired
  createdBy       String
  createdById     String
  createdByRef    ChvUser  @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  acknowledgedBy  String?
  acknowledgedAt  DateTime?
  completedAt     DateTime?
  followUpRequired Boolean  @default(true)

  followUps       FollowUp[]

  @@index([encounterId])
  @@index([status])
  @@index([householdId])
}

/// Policy Version — the deterministic safety policy is versioned, auditable,
/// and independently deployable from the model (§12). Each policy evaluation
/// records which version was used.
model PolicyVersion {
  id          String   @id @default(cuid())
  version     String   @unique // e.g. "1.0.0"
  description String
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
}
