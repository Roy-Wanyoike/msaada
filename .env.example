# Msaada — environment template
# Copy to `.env.local` (git-ignored) and fill in real values. Next.js loads
# .env.local automatically and it overrides .env.
#
# SECURITY: never put real API keys in any file that git tracks. The Qwen key
# below is a PLACEHOLDER.

# --- Database (Prisma + SQLite) ---------------------------------------------
# Relative paths resolve against prisma/schema.prisma. On Vercel, SQLite is
# ephemeral — point DATABASE_URL at a hosted DB for durable deployments.
DATABASE_URL=file:../db/custom.db

# --- Session signing (required in production) --------------------------------
# Generate: openssl rand -base64 48
# Production refuses to sign sessions without a >=32 char secret (fails fast
# at request time, not build time).
MSAADA_SESSION_SECRET=

# --- Qwen AI (Hack for Humanity with Qwen — ModelScope endpoint) -------------
# Base URL: https://api-inference.modelscope.ai/v1
# Chat models verified on ModelScope:
#   Qwen-Ambassador/Qwen3.8-Max  (default)
#   Qwen-Ambassador/Qwen3.7-Max
#   Qwen-Ambassador/Qwen3.7-Plus
# NOTE: "Qwen3.8-plus" from the hackathon email is NOT a valid id on the
# inference endpoint (400 "Invalid model id", any casing).
# DashScope/Model Studio alternative:
#   QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   QWEN_MODEL=qwen-plus
QWEN_API_KEY=
QWEN_BASE_URL=https://api-inference.modelscope.ai/v1
QWEN_MODEL=Qwen-Ambassador/Qwen3.8-Max
QWEN_TIMEOUT_MS=15000

# --- Voice notes (speech-to-text) --------------------------------------------
# Verified live on ModelScope (Hack for Humanity with Qwen) using the omni
# audio model:
#   QWEN_ASR_MODEL=Qwen-Ambassador/Qwen3.8-Omni-Flash
# (QWEN_ASR_BASE_URL can stay empty — same ModelScope endpoint as chat.)
# Alternative: dedicated ASR models on DashScope, e.g.
#   QWEN_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_ASR_MODEL=
QWEN_ASR_BASE_URL=

# --- Supabase (optional enhancement layer) ------------------------------------
# Dashboard → Project Settings → API. Publishable key is safe client-side.
# Run supabase/schema.sql in the SQL Editor once. Without these vars the app
# runs entirely on its own auth + database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
